Table users{
  id int [pk,increment]
  name varchar [not null]
  email varchar [unique, not null]
  password varchar [not null]
  role varchar [not null]
}

Table books{
  id int [pk,increment]
  title varchar [not null]
  author_id int [not null]
  available boolean [not null]
  category_id int [not null]
  publication_year int [not null]
  isbn varhar [unique,not null]
}

Table authors{
  id int [pk,increment]
  name varchar [not null]
  birth_date date
  death_date date
  country varchar [not null]
}

Table categories{
  id int [pk,increment]
  name varchar [unique,not null]
}

Table borrowings{
  id int [pk,increment]
  user_id int [not null]
  book_id int [not null]
  borrow_date date [not null]
  due_date date [not null]
  return_date date
  status varchar [not null]
}

Table reviews{
  id int [pk,increment]
  user_id int [not null]
  book_id int [not null]
  rating int [not null]
  commentn varchar [not null]
  created_at timestamp [not null]
}

Ref: books.author_id > authors.id
Ref: books.category_id > categories.id

Ref: borrowings.user_id > users.id
Ref: borrowings.book_id > books.id

Ref: reviews.user_id > users.id
Ref: reviews.book_id > books.id










